# Copy this file to ".env" and fill in your own values.
# The real .env file is listed in .gitignore, so it is never uploaded to GitHub.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=gym_management

# Any long random text. Flask uses it to sign flash messages.
SECRET_KEY=replace_with_any_random_text
